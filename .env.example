# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 Git에 올리지 않는다.

# 국가법령정보 OPEN API 인증키(OC). https://open.law.go.kr 에서 신청할 때 직접 정한 값.
LAW_OC=

# 인증키를 신청할 때 도메인을 등록했다면 그 주소(예: https://example.com/).
# 도메인을 등록한 인증키는 이 값을 Referer로 보내야 통과한다. "도메인 없음"이면 비워 둔다.
# 호출하는 장비의 IP도 마이페이지에 등록되어 있어야 한다.
LAW_REFERER=

# ── 규제 Agent(scripts/agent.py, scripts/agent_server.py). 모두 비워 두어도 돈다: 모델 없이 카드에서 뽑아 답한다 ──

# 모델을 쓸 때만. OpenAI 호환 주소(/chat/completions가 있는 주소). 예: Ollama는 http://127.0.0.1:11434/v1
AGENT_MODEL_BASE_URL=
# 모델 이름. 비우면 qwen3:4b
AGENT_MODEL=
# brief(기본): 자료를 코드가 찾아 주고 모델은 한 번만 부른다. 작은 모델·CPU에 맞다
# tools: 모델이 도구를 불러 스스로 찾는다. 도구 호출을 잘하는 큰 모델에서만
AGENT_MODEL_STYLE=
# 호출 한 번의 제한 시간(초). CPU만 있는 컴퓨터의 qwen3:4b는 한 번에 1~2분 걸린다
AGENT_MODEL_TIMEOUT=300
# 모델 주소가 키를 요구할 때만
AGENT_MODEL_API_KEY=

# HTTP 서버를 띄울 때 호출하는 쪽이 Authorization: Bearer로 보내는 키. 32자 이상의 임의 문자열
AGENT_AUTH_KEY=
# 브라우저에서 직접 부르게 할 때만. 허용할 Origin 하나(예: https://oreumit.com)
AGENT_ALLOWED_ORIGIN=
